@using System.Text.Json

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var cartJson = Context.Session.GetString("Cart");
    var cart = string.IsNullOrEmpty(cartJson)
        ? new List<CartItem>()
        : JsonSerializer.Deserialize<List<CartItem>>(cartJson);
    var cartCount = cart.Sum(x => x.Quantity);

    // LoggingBuilderExtensions data 
    var jwtToken = Context.Session.GetString("JWTToken");
    string? loggedInName = null;
    string? loggedInRole = null;

    if (!string.IsNullOrEmpty(jwtToken))
    {
        var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
        var decoded = handler.ReadJwtToken(jwtToken);

        loggedInName = decoded.Claims
            .FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)
            ?.Value;

        loggedInRole = decoded.Claims
        .FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
    }
}

     
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ECommerce.Web</title>
    <script src="https://cdn.tailwindcss.com"></script>
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/ECommerce.Web.styles.css" asp-append-version="true" /> *@
</head>
<body class="bg-gray-50 text-gray-900">
   
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100">

        <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-4">

            <div class="flex items-center justify-between">

                <!-- LOGO -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-2xl font-extrabold text-gray-900
                      hover:text-indigo-600 transition-colors duration-300">
                    ECommerce
                </a>

              
                <!-- DESKTOP MENU -->
                <ul class="hidden md:flex items-center gap-2">

                    <li>
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="px-4 py-2 rounded-lg font-semibold transition text-gray-600 hover:text-indigo-600 hover:bg-indigo-50
                           @(currentController == "Home" && currentAction == "Index"
                           ? "text-indigo-600 bg-indigo-50" : "")">
                            Home
                        </a>
                    </li>


                    <li>
                        <a asp-controller="Product"
                           asp-action="Index"
                           class="px-4 py-2 rounded-lg
                              text-gray-600 font-semibold transition
                           @(currentController == "Product" && currentAction == "Index"  ? "text-indigo-600 bg-indigo-50"
                                : "text-gray-600 hover:text-indigo-600 hover:bg-indigo-50")">
                            Products
                        </a>
                    </li>
                  

                    <li>
                        <a  asp-controller="Cart" asp-action="Index" 
                           class="px-4 py-2 rounded-lg
                              text-gray-600 font-semibold
                              transition  @(currentController == "Cart" && currentAction == "Index"
                               ? "text-indigo-600 bg-indigo-50" : "")">
                            🛒 Cart
                            <span id="cart-count" class="ml-1 text-xs
                                     bg-indigo-600 text-white
                                     px-1.5 py-0.5 rounded-full">
                                @cartCount
                            </span>
                        </a>
                    </li>

                    @* <li>
                        <button type="button" id="sunBtn">☀️</button>
                        <button type="button" id="moonBtn">🌙</button>
                    </li> *@

                    <li>
                        @if (!string.IsNullOrEmpty(loggedInName))
                        {
                            <div class="relative group">
                                <button class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-100 hover:bg-gray-200 transition">
                                    <span class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center text-sm font-bold">
                                        @loggedInName.Substring(0, 1).ToUpper()
                                    </span>
                                    <span class="font-semibold text-gray-700">@loggedInName</span>
                                </button>
                                <div class="hidden group-hover:block absolute right-0 mt-2 w-40 bg-white border border-gray-100 rounded-xl shadow-lg py-2">
                                    <a asp-controller="Account" asp-action="Profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">My Profile</a>
                                    <a asp-controller="Account" asp-action="Wislist" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">My favorite</a>
                                    <a asp-controller="Order" asp-action="MyOrders" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">My Orders</a>
                                   @if(loggedInRole == "Admin")
                                   {
                                    <a asp-controller="Admin" asp-action="Index" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Admin Panel</a>
                                   }
                                    <a asp-controller="Account" asp-action="Logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-gray-50">Sign Out</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                               class="ml-2 px-5 py-2.5 rounded-full
                                  bg-indigo-600 text-white
                                  font-semibold
                                  shadow-md shadow-indigo-200
                                  hover:bg-indigo-700
                                  hover:-translate-y-0.5
                                  transition-all duration-300">
                                Login
                            </a>
                        }
                    </li>

                </ul>

                <!-- MOBILE BUTTON -->
                <button type="button"
                        id="menuButton"
                        class="md:hidden  w-10 h-10 flex items-center justify-center rounded-lg
                           bg-gray-100 text-gray-700 hover:bg-indigo-50  hover:text-indigo-600  transition">
                        ☰
                </button>
            </div>


            <!-- MOBILE MENU -->
            <div id="mobileMenu" class="hidden md:hidden pt-4">
                <div class="flex flex-col gap-2">

                    <!-- Main Navigation -->
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="rounded-lg bg-indigo-50 px-4 py-3 font-semibold text-indigo-600 transition hover:bg-indigo-100">
                        Home
                    </a>

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="rounded-lg px-4 py-3 text-gray-600 transition hover:bg-indigo-50 hover:text-indigo-600">
                        Products
                    </a>

                    <a asp-controller="Cart"
                       asp-action="Index"
                       class="rounded-lg px-4 py-3 text-gray-600 transition hover:bg-indigo-50 hover:text-indigo-600">
                        Cart
                    </a>


                    <!-- Account Section -->
                    @if (!string.IsNullOrEmpty(loggedInName))
                    {
                        <div class="mt-2 border-t border-gray-200 pt-2">

                            <p class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-gray-400">
                                Account
                            </p>

                            <a asp-controller="Account"
                               asp-action="Profile"
                               class="block rounded-lg px-4 py-3 text-gray-600 transition hover:bg-indigo-50 hover:text-indigo-600">
                                My Profile
                            </a>

                            <a asp-controller="Product"
                               asp-action="Wislist"
                               class="block rounded-lg px-4 py-3 text-gray-600 transition hover:bg-indigo-50 hover:text-indigo-600">
                                My Wishlist
                            </a>

                            <a asp-controller="Order"
                               asp-action="MyOrders"
                               class="block rounded-lg px-4 py-3 text-gray-600 transition hover:bg-indigo-50 hover:text-indigo-600">
                                My Orders
                            </a>


                            @if (loggedInRole == "Admin")
                            {
                                <a asp-controller="Admin"
                                   asp-action="Index"
                                   class="block rounded-lg bg-purple-50 px-4 py-3 font-semibold text-purple-600 transition hover:bg-purple-100">
                                    Admin Panel
                                </a>
                            }


                            <a asp-controller="Account"
                               asp-action="Logout"
                               class="mt-1 block rounded-lg px-4 py-3 font-medium text-red-500 transition hover:bg-red-50 hover:text-red-600">
                                Sign Out
                            </a>

                        </div>
                    }
                    else
                    {
                        <!-- Login -->
                        <div class="mt-2 border-t border-gray-200 pt-3">

                            <a asp-controller="Account"
                               asp-action="Login"
                               class="block rounded-lg bg-indigo-600 px-4 py-3 text-center font-semibold text-white shadow-sm transition hover:bg-indigo-700">
                                Login
                            </a>

                        </div>
                    }

                </div>
            </div>


            </div>

        </nav>

    </header>



    @* modal *@
    <div id="loginModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-white rounded-2xl p-8 max-w-sm w-full text-center">
            <h2 class="text-xl font-bold text-gray-900 mb-3">Please Login First</h2>
            <p class="text-gray-500 mb-6">You need an account to add items to your cart.</p>
            <a asp-controller="Account" asp-action="Login"
               class="block w-full bg-indigo-600 text-white font-bold py-3 rounded-full hover:bg-indigo-700">
                Go to Login
            </a>
        </div>
    </div>

    <main>
        @RenderBody()
    </main>


    @* footer  *@
    <footer class="bg-gray-900 text-gray-300 mt-16">
        <div class="max-w-7xl mx-auto px-4 py-10 text-center text-sm">
            &copy; 2026 ECommerce. All rights reserved.
        </div>
    </footer>


    <script src="~/js/site.js" asp-append-version="true"></script>









    @* javscript for logic side  *@
    <script>
        const menuButton = document.getElementById("menuButton");
        const mobileMenu = document.getElementById("mobileMenu");

        menuButton.addEventListener("click", () => {
            mobileMenu.classList.toggle("hidden");
        });
    </script>


 <script>
        document.querySelectorAll('form').forEach(function (form) {
            if (form.action.includes('/Cart/AddToCart')) {
                form.addEventListener('submit', async function (event) {
                    event.preventDefault();

                    const formData = new FormData(form);

                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();

            if (data.requiresLogin) {
                document.getElementById('loginModal').classList.remove('hidden');
                return;
            }

                    document.getElementById('cart-count').textContent = data.cartCount;
                });
            }
        });
    </script>





    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
