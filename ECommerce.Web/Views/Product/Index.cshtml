@model List<ProductDto>
@using ECommerce.Application.DTOs.Products



<section class="max-w-7xl mx-auto px-4 py-12">

    <!-- Heading -->
    <h1 class="text-3xl font-bold mb-6">
        All products
    </h1>


    <!-- Categories -->
    <div class="flex justify-between">
    <div class="flex flex-wrap gap-3 mb-8">

        <a href="/Product"
           class="bg-purple-100 border border-purple-200 rounded-full px-4 py-2 text-sm font-medium
                  hover:bg-purple-600 hover:text-white transition">
            All
        </a>

        <a href="/Product?category=Electronics"
           class="bg-purple-100 border border-purple-200 rounded-full px-4 py-2 text-sm font-medium
                  hover:bg-purple-600 hover:text-white transition">
            Electronics
        </a>

        <a href="/Product?category=Furniture"
           class="bg-purple-100 border border-purple-200 rounded-full px-4 py-2 text-sm font-medium
                  hover:bg-purple-600 hover:text-white transition">
            Furniture
        </a>

        <a href="/Product?category=Footwear"
           class="bg-purple-100 border border-purple-200 rounded-full px-4 py-2 text-sm font-medium
                  hover:bg-purple-600 hover:text-white transition">
            Footwear
        </a>

        <a href="/Product?category=Bags"
           class="bg-purple-100 border border-purple-200 rounded-full px-4 py-2 text-sm font-medium
                  hover:bg-purple-600 hover:text-white transition">
            Bags
        </a>
    </div>

        <div>
            <select onchange="window.location.href = '/Product?sortBy=' + this.value"
            class="
            appearance-none
            bg-purple-50
            border border-purple-200
            text-gray-800
            text-sm
            font-medium
            rounded-full
            px-5
            py-2.5
            pr-10
            cursor-pointer
            outline-none
            transition-all
            duration-200
            hover:bg-purple-100
            hover:border-purple-300
            focus:ring-2
            focus:ring-purple-300
            focus:border-purple-400">
                <option value="">All</option>
                <option value="price_asc">Low to High</option>
                <option value="price_desc">High to Low</option>
            </select>
        </div>
    </div>


    <!-- Products -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">

        @for (int i = 0; i < Model.Count; i++)
        {
            var product = Model[i];

            <div class="card-animate card-hover
                            border border-gray-200
                            rounded-x
                            p-4
                            bg-white
                            shadow-sm"
                 style="animation-delay: @(i * 120)ms">

                <!-- Image -->
                <div class="overflow-hidden rounded-lg mb-4">
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">

                        <img src="/images/@product.ProductImage"
                             alt="@product.Name"
                             class="product-image w-full h-48 object-cover rounded-lg" />
                    </a>
                </div>



                <!-- Product name -->
                <h3 class="font-semibold text-gray-800 text-lg mb-1">
                    @product.Name
                </h3>


                <!-- Price -->
                <p class="text-indigo-600 font-bold mb-4">
                    @product.Price
                </p>


                <!-- Button -->
              <form asp-controller="Cart" asp-action="AddToCart" method="post">
                  <input type="hidden" name="Quantity" value="1" />
                    <input type="hidden" name="ProductId" value="@product.Id" />
                    <button type="submit"
                            class="cart-btn
                       w-full
                       bg-indigo-600
                       text-white
                       py-2
                       rounded-lg
                       hover:bg-indigo-700 ">
                        Add to Cart
                    </button>
              </form>


            </div>
        }

    </div>

</section>


@* page pagination *@



<div class="flex justify-center gap-3 mt-8">

    @if (ViewBag.CurrentPage > 1)
    {
        <a asp-controller="Product" asp-action="Index"
        asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"
           class="px-4 py-2 rounded-full border border-gray-200 hover:bg-gray-50">
            ← Previous
        </a>
    }

    <span class="px-4 py-2 font-semibold border-1">Page @ViewBag.CurrentPage</span>
 @if (ViewBag.CurrentPage < ViewBag.TotalPages)
    {
        <a asp-controller="Product" asp-action="Index"
           asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"
           class="px-4 py-2 rounded-full border border-gray-200 hover:bg-gray-50">
            Next →
        </a>
    }

</div>
    
}