@model ProductDto
@using ECommerce.Application.DTOs.Products

<section class="min-h-screen bg-gray-50 py-12 sm:py-16">

    <div class="max-w-7xl mx-auto px-4 sm:px-6">

        <!-- Breadcrumb -->
        <div class="mb-8 text-sm text-gray-500">

            <a asp-controller="Home"
               asp-action="Index"
               class="hover:text-indigo-600 transition">
                Home
            </a>

            <span class="mx-2">/</span>

            <a asp-controller="Product"
               asp-action="Index"
               class="hover:text-indigo-600 transition">
                Products
            </a>

            <span class="mx-2">/</span>

            <span class="text-gray-900">
                @Model.Name
            </span>

        </div>


        <!-- PRODUCT -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">

            <!-- IMAGE -->
            <div class="reveal-on-scroll">

                <div class="group relative
                            bg-white
                            rounded-3xl
                            overflow-hidden
                            border border-gray-100
                            shadow-sm
                            hover:shadow-xl
                            transition-all duration-500">

                    <!-- Featured -->
                    <span class="absolute top-5 left-5 z-10
                                 bg-indigo-600 text-white
                                 px-4 py-2
                                 rounded-full
                                 text-xs font-bold
                                 shadow-lg">
                        Featured
                    </span>


                    <!-- Wishlist -->
                    <button type="button"
                            class="absolute top-5 right-5 z-10
                                   w-11 h-11
                                   rounded-full
                                   bg-white
                                   text-gray-600
                                   text-xl
                                   shadow-md
                                   hover:text-red-500
                                   hover:scale-110
                                   transition-all duration-300">
                        ♡
                    </button>


                    <!-- Product Image -->
                    <div class="aspect-square bg-gray-100 overflow-hidden ">
                        
                       <img src="/images/@Model.ProductImage"
                             alt="@Model.Name"
                             class="w-full h-full
                                    object-cover
                                    transition-transform
                                    duration-700
                                    group-hover:scale-105" /> 

                    </div>

                </div>

            </div>


            <!-- PRODUCT INFORMATION -->
            <div
                 style="transition-delay: 200ms;">

                <!-- Category -->
                <span class="inline-block
                             bg-indigo-100
                             text-indigo-600
                             px-3 py-1.5
                             rounded-full
                             text-xs font-bold
                             uppercase">
                    Product
                </span>


                <!-- Name -->
                <h1 class="mt-5
                           text-3xl sm:text-4xl lg:text-5xl
                           font-extrabold
                           text-gray-900">
                    @Model.Name
                </h1>


                <!-- Rating -->
                <div class="mt-5 flex items-center gap-3">

                    <span class="text-yellow-400 text-lg">
                        ★★★★★
                    </span>

                    <span class="text-sm font-semibold text-gray-700">
                        4.9
                    </span>

                    <span class="text-sm text-gray-400">
                        (128 reviews)
                    </span>

                </div>


                <!-- Price -->
                <div class="mt-6">

                    <span class="text-3xl font-extrabold text-gray-900">
                        $@Model.Price
                    </span>

                </div>


                <!-- Description -->
                <div class="mt-7">

                    <h2 class="font-bold text-gray-900">
                        About this product
                    </h2>

                    <p class="mt-3 text-gray-600 leading-7">
                        Discover this high-quality product from our
                        collection. Designed with quality, comfort,
                        and style in mind.
                    </p>

                </div>


                <!-- Divider -->
                <div class="my-7 border-t border-gray-200"></div>


                <!-- Quantity -->
                <div>
                    <div class="flex items-center w-fit overflow-hidden">

                        <!-- Quantity + Add to Cart, ONE form -->
                        <form asp-controller="Cart" asp-action="AddToCart" method="post">

                            <input type="hidden" name="ProductId" value="@Model.Id" />

                            <!-- Quantity -->
                            <div>
                                <p class="text-sm font-semibold text-gray-900 mb-3">Quantity</p>

                                <div class="flex items-center w-fit bg-white border border-gray-200 rounded-full overflow-hidden">
                                    <button type="button" onclick="changeQty(-1)" class="w-11 h-11 hover:bg-gray-100 transition">−</button>
                                    <input type="number" id="qtyInput" name="Quantity" value="1" min="1" class="w-12 text-center border-0 outline-none" />
                                    <button type="button" onclick="changeQty(1)" class="w-11 h-11 hover:bg-gray-100 transition">+</button>
                                </div>
                            </div>

                            <!-- Buttons -->
                            <div class="mt-6 flex flex-col sm:flex-row gap-3 w-[340px]">
                                <button type="submit" class=" items-center justify-center gap-2 bg-indigo-600 text-white font-bold px-6 py-4 rounded-full shadow-lg shadow-indigo-200 hover:bg-indigo-700 hover:-translate-y-1 transition-all duration-300">
                                    🛒 Add to Cart
                                </button>

                                <button type="button" class=" bg-white border-2 border-gray-200 text-gray-900 font-bold px-6 py-4 rounded-full hover:border-indigo-600 hover:text-indigo-600 hover:-translate-y-1 transition-all duration-300">
                                    Buy Now
                                </button>
                            </div>

                        </form>
               
                    </div>

                </div>


             


                <!-- Benefits -->
                <div class="mt-8
                            grid grid-cols-1 sm:grid-cols-3 gap-4">

                    <div class="p-4 rounded-xl bg-white
                                border border-gray-100">

                        <div class="text-xl">
                            🚚
                        </div>

                        <p class="mt-2 text-xs font-bold text-gray-900">
                            Fast Delivery
                        </p>

                        <p class="text-xs text-gray-400">
                            2–5 days
                        </p>

                    </div>


                    <div class="p-4 rounded-xl bg-white
                                border border-gray-100">

                        <div class="text-xl">
                            🔒
                        </div>

                        <p class="mt-2 text-xs font-bold text-gray-900">
                            Secure Payment
                        </p>

                        <p class="text-xs text-gray-400">
                            100% protected
                        </p>

                    </div>


                    <div class="p-4 rounded-xl bg-white
                                border border-gray-100">

                        <div class="text-xl">
                            ↩️
                        </div>

                        <p class="mt-2 text-xs font-bold text-gray-900">
                            Easy Returns
                        </p>

                        <p class="text-xs text-gray-400">
                            30 days
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


@* ================= CUSTOMER REVIEWS ================= *@

<section class="bg-white py-16 sm:py-20">

    <div class="max-w-5xl mx-auto px-4 sm:px-6">

        @* Heading *@
        <div class="text-center mb-10">

            <p class="text-sm font-semibold text-indigo-600 uppercase tracking-wide">
                Customer Feedback
            </p>

            <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-gray-900">
                Customer Reviews
            </h2>

            <p class="mt-3 text-gray-500">
                Share your experience with this product.
            </p>

        </div>


        @* ================= REVIEW FORM ================= *@

        <div class="max-w-2xl mx-auto
                    bg-gray-50
                    rounded-3xl
                    border border-gray-100
                    shadow-sm
                    p-6 sm:p-8">

            <h3 class="text-xl font-bold text-gray-900">
                Write a Review
            </h3>

            <p class="mt-1 text-sm text-gray-500">
                Your feedback helps other customers.
            </p>


            <form asp-controller="Product"
                  asp-action="AddReview"
                  method="post"
                  class="mt-6 space-y-6">

                @* Product Id *@
                <input type="hidden"
                       name="ProductId"
                       value="@Model.Id" />


                @* Customer Name *@
                <div>

                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Customer
                    </label>

                    <input type="text"
                           name="CustomerName"
                           value="@ViewBag.CustomerName"
                           class="w-full
                                  bg-white
                                  border border-gray-200
                                  rounded-xl
                                  px-4 py-3
                                  text-gray-700
                                  outline-none
                                  " />

                </div>


                @* STAR RATING *@
                <div class="flex flex-row-reverse justify-end gap-1">

                    <input type="radio" id="star5" name="StarRating" value="5" class="peer hidden" />
                    <label for="star5" class="cursor-pointer text-3xl text-gray-300 hover:text-yellow-400 peer-checked:text-yellow-400 transition">★</label>

                    <input type="radio" id="star4" name="StarRating" value="4" class="peer hidden" />
                    <label for="star4" class="cursor-pointer text-3xl text-gray-300 hover:text-yellow-400 peer-checked:text-yellow-400 transition">★</label>

                    <input type="radio" id="star3" name="StarRating" value="3" class="peer hidden" />
                    <label for="star3" class="cursor-pointer text-3xl text-gray-300 hover:text-yellow-400 peer-checked:text-yellow-400 transition">★</label>

                    <input type="radio" id="star2" name="StarRating" value="2" class="peer hidden" />
                    <label for="star2" class="cursor-pointer text-3xl text-gray-300 hover:text-yellow-400 peer-checked:text-yellow-400 transition">★</label>

                    <input type="radio" id="star1" name="StarRating" value="1" class="peer hidden" />
                    <label for="star1" class="cursor-pointer text-3xl text-gray-300 hover:text-yellow-400 peer-checked:text-yellow-400 transition">★</label>

                </div>


                @* DESCRIPTION *@
                <div>

                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Your Review
                    </label>

                    <textarea name="Description"
                              rows="5"
                              placeholder="Tell us what you think about this product..."
                              class="w-full
                                     bg-white
                                     border border-gray-200
                                     rounded-2xl
                                     px-4 py-3
                                     text-gray-700
                                     placeholder-gray-400
                                     outline-none
                                     resize-none
                                     focus:ring-2
                                     focus:ring-indigo-200
                                     focus:border-indigo-500
                                     transition"></textarea>

                </div>


                @* SUBMIT *@
                <button type="submit"
                        class="w-full
                               bg-indigo-600
                               text-white
                               font-bold
                               py-3.5
                               rounded-full
                               shadow-lg
                               shadow-indigo-200
                               hover:bg-indigo-700
                               hover:-translate-y-1
                               transition-all duration-300">

                    Submit Review →

                </button>

            </form>

        </div>


        @* ================= EXISTING REVIEWS ================= *@

       <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-5">
            @foreach(var review in ViewBag.Reviews)
            {
                <div class="bg-gray-50 rounded-2xl border border-gray-100 p-6 hover:shadow-lg transition-all duration-300">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-bold text-gray-900">@review.CustomerName</p>
                            <p class="text-xs text-gray-400 mt-1">Verified Customer</p>
                        </div>
                        <div class="text-yellow-400">
                            @(new string('★', review.StarRating))
                        </div>
                    </div>
                    <p class="mt-4 text-gray-600 leading-7">@review.Description</p>

                </div>
            }
        </div>

    </div>

</section>



 <script>
     function changeQty(amount){
         const input =document.getElementById('qtyInput');
        let newValue = parseInt(input.value) + amount;
       if(newValue < 1) newValue = 1; // Prevent quantity from going below 1
       input.value = newValue;
     }
</script>

                        <script>
                                document.querySelectorAll('form').forEach(function (form) {
        const isCartForm = form.action.includes('/Cart/AddToCart');
        const isReviewForm = form.action.includes('/Product/AddReview');

        if (isCartForm || isReviewForm) {
            form.addEventListener('submit', async function (event) {
                event.preventDefault();
                const formData = new FormData(form);
                const response = await fetch(form.action, { method: 'POST', body: formData });
                const data = await response.json();

                if (data.requiresLogin) {
                    document.getElementById('loginModal').classList.remove('hidden');
                    return;
                }

                if (isCartForm) {
                    document.getElementById('cart-count').textContent = data.cartCount;
                } else if (isReviewForm) {
                     location.reload();
                }
            });
        }
    });
                        </script>