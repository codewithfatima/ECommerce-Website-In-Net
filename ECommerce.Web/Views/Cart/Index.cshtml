@using ECommerce.Web.Models
@model List<CartItem> 
@{
    var subtotal = Model.Sum(x => x.ProductPrice * x.Quantity);
}

@if(Model == null || Model.Count == 0)
{
    <h2 class="mt-5 text-xl font-bold text-gray-900 text-center">
        No products added to cart yet
    </h2>
}
else
{
    
<section class="min-h-screen bg-gray-50 py-12 sm:py-16">

    <div class="max-w-7xl mx-auto px-4 sm:px-6">

        <!-- HEADER -->
        <div class="mb-10">

            <p class="text-sm text-indigo-600 font-semibold">
                Your Shopping Cart
            </p>

            <h1 class="mt-2 text-3xl sm:text-4xl font-extrabold text-gray-900">
                Shopping Cart
            </h1>

            <p class="mt-2 text-gray-500">
                Review your items before checkout.
            </p>

        </div>


        <!-- CART LAYOUT -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">


            <!-- CART ITEMS -->
            <div class="lg:col-span-2 space-y-4">


                @foreach (var item in Model)
                {
                    <!-- CART ITEM -->
                    <div class="group bg-white rounded-2xl
                            border border-gray-100
                            shadow-sm
                            p-4 sm:p-6
                            flex flex-col sm:flex-row
                            gap-5
                            hover:shadow-lg
                            transition-all duration-300">

                    <!-- IMAGE -->
                    <div class="w-full sm:w-32 h-32
                                flex-shrink-0
                                rounded-xl
                                overflow-hidden
                                bg-gray-100">

                            <img src="/images/@item.ImageUrl" />
                             alt="@item.ImageUrl"
                             class="w-full h-full
                                    object-cover
                                    transition-transform
                                    duration-500
                                    group-hover:scale-105" />

                    </div>
          

                    <!-- INFORMATION -->
                    <div class="flex-1">

                        <div class="flex items-start justify-between gap-4">

                            <div>

                                <p class="text-xs font-semibold
                                          uppercase tracking-wide
                                          text-indigo-600">
                                    Product
                                </p>

                                <h2 class="mt-1 text-lg
                                           font-bold text-gray-900">
                                    @item.ProductPrice

                                </h2>

                            </div>


                            <!-- REMOVE -->
                                <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit"
                                            class="text-gray-400
                                               hover:text-red-500
                                               transition">
                                        ✕
                                    </button>
                           </form>

                        </div>


                        <!-- PRICE -->
                        <p class="mt-3 text-lg font-extrabold text-gray-900">
                            $@item.ProductPrice
                        </p>


                        <!-- QUANTITY -->
                        <div class="mt-5 flex items-center
                                    justify-between sm:justify-start
                                    gap-6">
                           
                            <div>

                                <p class="text-xs font-semibold
                                          text-gray-500 mb-2">
                                    Quantity
                                </p>

                                <div class="flex items-center
                                            border border-gray-200
                                            rounded-full
                                            overflow-hidden">

                             <form asp-controller="Cart" asp-action="DecreaseQuantity" method="post">
                                 <input type="hidden"  name="productId"  value="@item.ProductId" />
                                 <button type="submit"  class="w-9 h-9  hover:bg-gray-100  transition">− </button>
                             </form>

                                <span class="w-8 text-center font-semibold">
                                     @item.Quantity
                                </span>
                               
                                <form asp-controller="Cart" asp-action="IncreaseQuantity"  method="post">
                                 <input type="hidden" name="productId" value="@item.ProductId" />
                                 <button type="submit" class="w-9 h-9 hover:bg-gray-100 transition"> + </button>
                                </form>
</div>
</div>
                          
                            <!-- ITEM TOTAL -->
                            <div class="ml-auto">

                                <p class="text-xs text-gray-500">
                                    Total
                                </p>

                                <p class="mt-1 font-bold text-gray-900">
                                    $@item.ProductPrice
                                </p>

                            </div>

                        </div>

                    </div>

                </div>
}
                <!-- CONTINUE SHOPPING -->
                <div class="pt-4">

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="inline-flex items-center gap-2
                              text-indigo-600
                              font-semibold
                              hover:text-indigo-700
                              hover:gap-3
                              transition-all duration-300">

                        ← Continue Shopping

                    </a>

                </div>

            </div>


            <!-- ORDER SUMMARY -->
            <div>

                <div class="bg-white rounded-2xl
                            border border-gray-100
                            shadow-sm
                            p-6
                            lg:sticky lg:top-28">

                    <h2 class="text-xl font-bold text-gray-900">
                        Order Summary
                    </h2>


                    <!-- SUMMARY -->
                    <div class="mt-6 space-y-4">

                        <div class="flex justify-between
                                    text-gray-600">

                            <span>Subtotal</span>

                             <span class="font-semibold text-gray-900">
                                $@subtotal 
                            </span> 

                        </div>


                        <div class="flex justify-between
                                    text-gray-600">

                            <span>Shipping</span>

                            <p class="font-semibold text-green-600">
                                Free
                            </p>

                        </div>


                        <div class="flex justify-between
                                    text-gray-600">

                            <span>Tax</span>

                            <span class="font-semibold text-gray-900">
                                $0.00
                            </span>

                        </div>

                    </div>


                    <!-- DIVIDER -->
                    <div class="my-6 border-t border-gray-200"></div>


                    <!-- TOTAL -->
                    <div class="flex items-center justify-between">

                        <span class="text-lg font-bold text-gray-900">
                            Total
                        </span>

                         <span class="text-2xl font-extrabold
                                     text-indigo-600">
                           $@subtotal
                        </span> 

                    </div>
                    <div class="mt-8 rounded-2xl bg-white p-6 shadow-sm">
                        <h3 class="mb-4 text-lg font-bold">Payment Method</h3>

                        <form asp-controller="Order" asp-action="PlaceOrder" method="post">

                            <!-- hidden cart items -->
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <input type="hidden" name="Items[@i].ProductId" value="@Model[i].ProductId" />
                                <input type="hidden" name="Items[@i].Quantity" value="@Model[i].Quantity" />
                            }

                            <!-- payment methods -->
                            <div class="grid gap-3 sm:grid-cols-2">

                                <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 transition hover:border-indigo-300">
                                    <input type="radio" name="PaymentMethod" value="Card" checked class="accent-indigo-600" />
                                    <span class="text-sm font-semibold">💳 Card</span>
                                </label>

                                <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 transition hover:border-indigo-300">
                                    <input type="radio" name="PaymentMethod" value="Mastercard" class="accent-indigo-600" />
                                    <span class="text-sm font-semibold">🟠 Mastercard</span>
                                </label>

                                <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 transition hover:border-indigo-300">
                                    <input type="radio" name="PaymentMethod" value="Visa" class="accent-indigo-600" />
                                    <span class="text-sm font-semibold">🔵 Visa</span>
                                </label>

                                <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 transition hover:border-indigo-300">
                                    <input type="radio" name="PaymentMethod" value="CashOnDelivery" class="accent-indigo-600" />
                                    <span class="text-sm font-semibold">💰 Cash on Delivery</span>
                                </label>

                            </div>

                            <!-- Place Order button — INDIGO/PURPLE -->
                            <!-- CHECKOUT -->
                            <form asp-controller="Order" asp-action="PlaceOrder" method="post">

                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    <input type="hidden" name="Items[@i].ProductId" value="@Model[i].ProductId" />
                                    <input type="hidden" name="Items[@i].Quantity" value="@Model[i].Quantity" />
                                }
                                <button type="submit"
                                        class="mt-6 w-full
                                   bg-indigo-600
                                   text-white
                                   font-bold
                                   py-4
                                   rounded-full
                                   shadow-lg
                                   shadow-indigo-200
                                   hover:bg-indigo-700
                                   hover:-translate-y-1
                                   transition-all duration-300">

                                    Place order →

                                </button>
                            </form>
                        </form>
                    </div>

                   


                    <!-- SECURITY -->
                    <div class="mt-6 flex items-center
                                justify-center gap-2
                                text-xs text-gray-500">

                        <span>🔒</span>

                        <span>
                            Secure and encrypted checkout
                        </span>

                    </div>
                   
                </div>

            </div>

        </div>

    </div>

   
</section>


}
