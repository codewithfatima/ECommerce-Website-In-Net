@model List<Product>

@{
    ViewData["Title"] = "Home Page";
}

<!-- HERO -->
<section class="hero-section relative overflow-hidden">

    <!-- Background decorations -->
    <div class="hero-circle hero-circle-1"></div>
    <div class="hero-circle hero-circle-2"></div>

    <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28
                grid md:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- LEFT SIDE -->
        <div class="hero-content">

            <!-- Badge -->
            <span class="hero-badge">
                ✨ New Collection
            </span>

            <!-- Heading -->
            <h1 class="hero-title">
                Elevate Your
                <span>Everyday.</span>
            </h1>

            <!-- Description -->
            <p class="hero-description">
                Thoughtfully designed essentials that bring together
                timeless style, premium quality, and effortless comfort.
            </p>

            <!-- Buttons -->
            <div class="flex flex-wrap gap-4">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="hero-btn-primary">

                    Shop Now
                    <span>→</span>

                </a>


                <a asp-controller="Product"
                   asp-action="Index"
                   class="hero-btn-secondary">

                    Explore Collection

                </a>

            </div>


            <!-- Small trust information -->
            <div class="hero-trust">

                <div>
                    <strong>500+</strong>
                    <span>Products</span>
                </div>

                <div class="trust-divider"></div>

                <div>
                    <strong>4.9/5</strong>
                    <span>Customer Rating</span>
                </div>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="hero-image-wrapper">

            <!-- Decorative circle -->
            <div class="image-backdrop"></div>

            <!-- Product image -->
            <img src="~/images/Hero.png"
                 alt="Featured product"
                 class="hero-image" />

            <!-- Floating badge -->
            <div class="floating-badge">
                <span>⭐</span>

                <div>
                    <strong>Premium</strong>
                    <small>Quality</small>
                </div>
            </div>

        </div>

    </div>

</section>



    <!-- BENEFITS -->
    <section class="bg-gray-900 text-white overflow-hidden">

        <div class="max-w-7xl mx-auto px-6 py-8">

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

                <!-- Secure Payment -->
                <div class="benefit-item">
                    <div class="benefit-icon">
                        🔒
                    </div>

                    <div>
                        <h3>Secure Payment</h3>
                        <p>100% secure checkout</p>
                    </div>
                </div>


                <!-- Fast Delivery -->
                <div class="benefit-item">
                    <div class="benefit-icon">
                        🚚
                    </div>

                    <div>
                        <h3>Fast Delivery</h3>
                        <p>Quick & reliable shipping</p>
                    </div>
                </div>


                <!-- Easy Returns -->
                <div class="benefit-item">
                    <div class="benefit-icon">
                        ↩️
                    </div>

                    <div>
                        <h3>Easy Returns</h3>
                        <p>Simple return process</p>
                    </div>
                </div>


                <!-- Quality Products -->
                <div class="benefit-item">
                    <div class="benefit-icon">
                        ⭐
                    </div>

                    <div>
                        <h3>Quality Products</h3>
                        <p>Products you can trust</p>
                    </div>
                </div>

            </div>

        </div>

    </section>

@* ********************* FEATURED PRODUCTS ********************* *@
<section class="py-20 bg-gray-50 overflow-hidden">

    <div class="max-w-7xl mx-auto px-6">

        @* Section Heading *@
        <div class="text-center mb-14 reveal">

            <span class="inline-block px-4 py-2 rounded-full
                         bg-indigo-100 text-indigo-600
                         text-sm font-semibold">
                Our Collection
            </span>

            <h2 class="mt-4 text-3xl sm:text-4xl font-bold text-gray-900">
                Featured Products
            </h2>

            <p class="mt-3 text-gray-500 max-w-xl mx-auto">
                Discover our most popular products, carefully selected
                for quality and style.
            </p>

        </div>


        @* Product Grid *@
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

            @foreach (var item in Model.Select((product, index) => new { product, index }))
            {
                <div class="group product-card
                    bg-white rounded-2xl overflow-hidden
                    border border-gray-100
                    shadow-sm
                    hover:shadow-xl
                    hover:-translate-y-2
                    transition-all duration-300
                    reveal-on-scroll"
                     style="transition-delay: @(item.index * 300)ms;">

                    <div class="relative h-72 bg-gray-100 overflow-hidden">

                        <img src="@item.product.Thumbnail"
                             alt="@item.product.Title"
                             class="w-full h-full object-cover
                            transition-transform duration-500
                            group-hover:scale-105" />

                        <span class="absolute top-4 left-4
                             px-3 py-1.5
                             rounded-full
                             bg-white text-indigo-600
                             text-xs font-bold shadow-sm">
                            Featured
                        </span>

                        <button type="button"
                                class="absolute top-4 right-4
                               w-10 h-10
                               flex items-center justify-center
                               rounded-full bg-white
                               text-gray-600 text-xl
                               shadow-sm
                               hover:text-red-500
                               hover:scale-110
                               transition-all duration-300">
                            ♡
                        </button>

                    </div>

                    <div class="p-6">

                        <p class="text-xs font-semibold uppercase
                          tracking-wide text-indigo-600">
                            Featured Collection
                        </p>

                        <h3 class="mt-2 text-lg font-bold text-gray-900 truncate">
                            @item.product.Title
                        </h3>

                        <div class="mt-4 flex items-center justify-between">

                            <span class="text-xl font-extrabold text-gray-900">
                                $@item.product.Price
                            </span>

                            <span class="text-sm font-semibold text-yellow-500">
                                ★ 4.9
                            </span>

                        </div>

                        <button type="button"
                                class="mt-5 w-full
                               flex items-center justify-between
                               px-5 py-3.5
                               rounded-full
                               bg-indigo-600 text-white
                               font-semibold
                               hover:bg-indigo-700
                               hover:-translate-y-0.5
                               transition-all duration-300">

                            <span>Add to Cart</span>

                            <span class="transition-transform duration-300
                                 group-hover:translate-x-1">
                                →
                            </span>

                        </button>

                    </div>

                </div>
            }


        </div>

    </div>

</section>



    @* Why Shop With Us *@
    <section class="reveal-on-scroll py-20 bg-gradient-to-b from-white to-gray-50 overflow-hidden" 
     style="transition-delay: 0ms;">

        <div class="max-w-7xl mx-auto px-6">

