                    <div class="icon-box">
                        <span>🔒</span>
                    </div>

                    <h3 class="mt-6 text-lg font-bold text-gray-900">
                        Secure Shopping
                    </h3>

                    <p class="mt-2 text-sm text-gray-500">
                        Your information and payments are protected.
                    </p>

                    <div class="card-line"></div>

                </div>


                @* Returns *@
                <div class="service-card reveal delay-300">

                    <div class="icon-box">
                        <span>↩️</span>
                    </div>

                    <h3 class="mt-6 text-lg font-bold text-gray-900">
                        Easy Returns
                    </h3>

                    <p class="mt-2 text-sm text-gray-500">
                        Return your products easily when needed.
                    </p>

                    <div class="card-line"></div>

                </div>


                @* Support *@
                <div class="service-card reveal delay-400">

                    <div class="icon-box">
                        <span>💬</span>
                    </div>

                    <h3 class="mt-6 text-lg font-bold text-gray-900">
                        24/7 Support
                    </h3>

                    <p class="mt-2 text-sm text-gray-500">
                        Our support team is here whenever you need help.
                    </p>

                    <div class="card-line"></div>

                </div>

            </div>

        </div>

    </section>


  
