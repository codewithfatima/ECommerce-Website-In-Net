<!-- Status -->
<div class="col-span-2">
    <form asp-controller="Order"
          asp-action="UpdateStatus"
          asp-route-id="@order.Id"
          method="post">

          @{
    var selectCls = order.Status switch
    {
        OrderStatus.Pending   => "bg-amber-50 text-amber-700 border-amber-200",
        OrderStatus.Confirmed => "bg-blue-50 text-blue-700 border-blue-200",
        OrderStatus.Shipped   => "bg-purple-50 text-purple-700 border-purple-200",
        OrderStatus.Delivered => "bg-emerald-50 text-emerald-700 border-emerald-200",
        OrderStatus.Cancelled => "bg-red-50 text-red-700 border-red-200",
        _                     => "bg-white text-slate-700 border-slate-200"
    };
}

<select name="NewStatus"
        onchange="this.form.submit()"
        class="rounded-lg border px-3 py-1.5 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-200 @selectCls">

    @foreach (var status in Enum.GetValues<OrderStatus>())
    {
        <option value="@((int)status)"
                selected="@(order.Status == status)">
            @status
        </option>
    }
</select>
    </form>

 
</div>

    <!-- Total -->
    <div class="col-span-2">
        <p class="font-bold text-slate-900">
            @order.TotalAmount.ToString("C")
        </p>
    </div>


    <!-- Action -->
    <div class="col-span-3 flex items-center justify-end gap-2">

        @if (order.Status == OrderStatus.Pending)
        {
            <!-- Confirm -->
            <form asp-controller="Order"
                  asp-action="UpdateStatus"
                  asp-route-id="@order.Id"
                  method="post">

                <input type="hidden"
                       name="NewStatus"
                       value="@((int)OrderStatus.Confirmed)" />

                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-lg
                               bg-indigo-600 px-4 py-2 text-sm font-semibold
                               text-white shadow-sm transition
                               hover:bg-indigo-700
                               focus:outline-none focus:ring-2
                               focus:ring-indigo-500 focus:ring-offset-2">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="h-4 w-4"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M5 13l4 4L19 7" />
                    </svg>

                    Confirm
                </button>
            </form>

            <!-- Cancel -->
            <form asp-controller="Order"
                  asp-action="UpdateStatus"
                  asp-route-id="@order.Id"
                  method="post">

                <input type="hidden"
                       name="NewStatus"
                       value="@((int)OrderStatus.Cancelled)" />

                <button type="submit"
                        class="rounded-lg border border-red-200
                               bg-white px-4 py-2 text-sm font-semibold
                               text-red-600 transition
                               hover:bg-red-50
                               focus:outline-none focus:ring-2
                               focus:ring-red-500 focus:ring-offset-2">

                    Cancel
                </button>
            </form>
        }

        else if (order.Status == OrderStatus.Confirmed)
        {
            <!-- Ship -->
            <form asp-controller="Order"
                  asp-action="UpdateStatus"
                  asp-route-id="@order.Id"
                  method="post">

                <input type="hidden"
                       name="NewStatus"
                       value="@((int)OrderStatus.Shipped)" />

                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-lg
                               bg-indigo-600 px-4 py-2 text-sm font-semibold
                               text-white shadow-sm transition
                               hover:bg-indigo-700
                               focus:outline-none focus:ring-2
                               focus:ring-indigo-500 focus:ring-offset-2">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="h-4 w-4"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M5 13l4 4L19 7" />
                    </svg>

                    Ship
                </button>
            </form>

            <!-- Cancel -->
            <form asp-controller="Order"
                  asp-action="UpdateStatus"
                  asp-route-id="@order.Id"
                  method="post">

                <input type="hidden"
                       name="NewStatus"
                       value="@((int)OrderStatus.Cancelled)" />

                <button type="submit"
                        class="rounded-lg border border-red-200
                               bg-white px-4 py-2 text-sm font-semibold
                               text-red-600 transition
                               hover:bg-red-50
                               focus:outline-none focus:ring-2
                               focus:ring-red-500 focus:ring-offset-2">

                    Cancel
                </button>
            </form>
        }

        else
        {
            <span class="text-sm text-slate-400">
                No actions
            </span>
        }

    </div>

</div>
</div>


