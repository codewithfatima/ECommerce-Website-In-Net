<div class="md:hidden">

    <div class="space-y-4">

        <!-- Order Card -->
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">

            <!-- Header -->
            <div class="flex items-start justify-between gap-3">

                <div>
                    <p class="text-base font-bold text-slate-900">
                        Order #@order.Id
                    </p>

                    <p class="mt-1 text-xs text-slate-400">
                        Order ID: @order.Id
                    </p>
                </div>


                <!-- Status Badge -->
                @{
                    var mobileStatusClass = order.Status switch
                    {
                        OrderStatus.Pending =>
                            "bg-amber-50 text-amber-700 ring-amber-600/20",

                        OrderStatus.Confirmed =>
                            "bg-blue-50 text-blue-700 ring-blue-600/20",

                        OrderStatus.Shipped =>
                            "bg-purple-50 text-purple-700 ring-purple-600/20",

                        OrderStatus.Delivered =>
                            "bg-emerald-50 text-emerald-700 ring-emerald-600/20",

                        OrderStatus.Cancelled =>
                            "bg-red-50 text-red-700 ring-red-600/20",

                        _ =>
                            "bg-slate-50 text-slate-700 ring-slate-600/20"
                    };

                    var mobileDotClass = order.Status switch
                    {
                        OrderStatus.Pending => "bg-amber-500",
                        OrderStatus.Confirmed => "bg-blue-500",
                        OrderStatus.Shipped => "bg-purple-500",
                        OrderStatus.Delivered => "bg-emerald-500",
                        OrderStatus.Cancelled => "bg-red-500",
                        _ => "bg-slate-500"
                    };
                }

                <span class="inline-flex shrink-0 items-center gap-1.5
                             rounded-full px-3 py-1 text-xs font-semibold
                             ring-1 ring-inset @mobileStatusClass">

                    <span class="h-1.5 w-1.5 rounded-full @mobileDotClass"></span>

                    @order.Status

                </span>

            </div>


            <!-- Customer -->
            <div class="mt-4 border-t border-slate-100 pt-4">

                <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                    Customer
                </p>

                <p class="mt-1 text-sm font-semibold text-slate-900">
                    @order.CustomerName
                </p>

            </div>


            <!-- Order Information -->
            <div class="mt-4 grid grid-cols-2 gap-4 border-t border-slate-100 pt-4">

                <!-- Quantity -->
                <div>

                    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                        Quantity
                    </p>

                    <p class="mt-1 text-sm font-semibold text-slate-900">
                        @order.Items.Count item@(order.Items.Count != 1 ? "s" : "")
                    </p>

                </div>


                <!-- Total -->
                <div>

                    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                        Total
                    </p>

                    <p class="mt-1 text-sm font-bold text-slate-900">
                        @order.TotalAmount.ToString("C")
                    </p>

                </div>

            </div>


            <!-- Date -->
            <div class="mt-4 border-t border-slate-100 pt-4">

                <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                    Date
                </p>

                <p class="mt-1 text-sm font-medium text-slate-700">
                    @order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                </p>

            </div>


            <!-- Update Status -->
            @if (order.Status != OrderStatus.Delivered &&
                 order.Status != OrderStatus.Cancelled)
            {
                <div class="mt-4 border-t border-slate-100 pt-4">

                    <p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-400">
                        Update Status
                    </p>

                    <form asp-controller="Order"
                          asp-action="UpdateStatus"
                          asp-route-id="@order.Id"
                          method="post"
                          class="flex gap-2">

                        <select name="NewStatus"
                                class="min-w-0 flex-1 rounded-lg border border-slate-300
                                       bg-white px-3 py-2 text-sm font-medium
                                       text-slate-700 shadow-sm
                                       focus:border-indigo-500
                                       focus:outline-none
                                       focus:ring-2 focus:ring-indigo-500/20">

                            @if (order.Status == OrderStatus.Pending)
                            {
                                <option value="@((int)OrderStatus.Pending)" selected>
                                    Pending
                                </option>

                                <option value="@((int)OrderStatus.Confirmed)">
                                    Confirmed
                                </option>

                                <option value="@((int)OrderStatus.Cancelled)">
                                    Cancelled
                                </option>
                            }
                            else if (order.Status == OrderStatus.Confirmed)
                            {
                                <option value="@((int)OrderStatus.Confirmed)" selected>
                                    Confirmed
                                </option>

                                <option value="@((int)OrderStatus.Shipped)">
                                    Shipped
                                </option>

                                <option value="@((int)OrderStatus.Cancelled)">
                                    Cancelled
                                </option>
                            }
                            else if (order.Status == OrderStatus.Shipped)
                            {
                                <option value="@((int)OrderStatus.Shipped)" selected>
                                    Shipped
                                </option>

                                <option value="@((int)OrderStatus.Delivered)">
                                    Delivered
                                </option>
                            }

                        </select>


                        <button type="submit"
                                class="shrink-0 rounded-lg bg-indigo-600
                                       px-4 py-2 text-sm font-semibold text-white
                                       shadow-sm transition
                                       hover:bg-indigo-700
                                       focus:outline-none
                                       focus:ring-2 focus:ring-indigo-500
                                       focus:ring-offset-2">

                            Update

                        </button>

                    </form>

                </div>
            }
            else
            {
                <div class="mt-4 border-t border-slate-100 pt-4">

                    <p class="text-sm text-slate-400">
                        No actions available
                    </p>

                </div>
            }

        </div>

