
@{
    Layout = "_AuthLayout";
}

@model ECommerce.Application.DTOs.Auth.ProfileDto

<div class="min-h-screen bg-slate-50 py-10">

    <div class="mx-auto max-w-3xl px-4 sm:px-6">

        <!-- Back to Home -->
        <div class="mb-6">
            <a asp-controller="Home"
               asp-action="Index"
               class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 transition hover:text-indigo-600">

                <span>←</span>
                Back to Home

            </a>
        </div>


        <!-- Page Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                My Profile
            </h1>

            <p class="mt-2 text-sm text-slate-500">
                Manage your personal information and profile picture.
            </p>
        </div>


        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 flex items-center gap-3 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-semibold text-green-700">

                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-green-100">
                    ✓
                </span>

                @TempData["SuccessMessage"]

            </div>
        }


        <!-- Profile Card -->
        <div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-200">

            <!-- Top Profile Section -->
            <div class="bg-gradient-to-r from-indigo-600 to-violet-600 px-6 py-8 sm:px-8">

                <div class="flex flex-col items-center gap-4 sm:flex-row">

                    <!-- Profile Image -->
                    <div class="relative">

                        @if (!string.IsNullOrEmpty(Model.ProfileImage))
                        {
                            <img id="profilePreview"
                                 src="@Model.ProfileImage"
                                 alt="Profile"
                                 class="h-28 w-28 rounded-full border-4 border-white object-cover shadow-lg" />
                        }
                        else
                        {
                            <div id="profilePlaceholder"
                                 class="flex h-28 w-28 items-center justify-center rounded-full border-4 border-white bg-white text-4xl font-bold text-indigo-600 shadow-lg">
                                @(string.IsNullOrEmpty(Model.FullName)
                                                            ? "U"
                                                            : Model.FullName.Substring(0, 1).ToUpper())
                        </div>
                                                }

                    </div>


                    <!-- User Information -->
                    <div class="text-center text-white sm:text-left">

                        <h2 class="text-2xl font-bold">
                            @(string.IsNullOrEmpty(Model.FullName)
                                                        ? "Your Profile"
                                                        : Model.FullName)
                        </h2>

                        <p class="mt-1 text-sm text-indigo-100">
                            @Model.Email
                        </p>

                    </div>

                </div>

            </div>


            <!-- Form -->
            <form asp-controller="Account"
                  asp-action="Profile"
                  method="post"
                  enctype="multipart/form-data"
                  class="p-6 sm:p-8">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Email" />


                <!-- Profile Picture -->
                <div>

                    <label class="block text-sm font-semibold text-slate-700">
                        Profile Picture
                    </label>

                    <p class="mt-1 text-xs text-slate-500">
                        Choose a JPG, PNG or WEBP image.
                    </p>


                    <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-center">

                        <!-- Choose Image Button -->
                        <label for="profileImageInput"
                               class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 shadow-sm transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-600">

                            <span>📷</span>
                            Choose Image

                        </label>

                        <input id="profileImageInput"
                               name="profileImageFile"
                               type="file"
                               accept="image/png,image/jpeg,image/webp"
                               class="hidden" />

                        <span id="fileName"
                              class="text-sm text-slate-500">
                            No image selected
                        </span>

                    </div>

                </div>


                <!-- Full Name -->
                <div class="mt-8">

                    <label asp-for="FullName"
                           class="block text-sm font-semibold text-slate-700">
                        Full Name
                    </label>

                    <input asp-for="FullName"
                           placeholder="Enter your full name"
                           class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" />

                    <span asp-validation-for="FullName"
                          class="mt-1 block text-xs text-red-500">
                    </span>

                </div>


                <!-- Email -->
                <div class="mt-6">

                    <label class="block text-sm font-semibold text-slate-700">
                        Email Address
                    </label>

                    <div class="mt-2 flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">

                        <span class="text-slate-400">
                            ✉
                        </span>

                        <span class="text-sm text-slate-500">
                            @Model.Email
                        </span>

                        <span class="ml-auto rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold text-slate-500">
                            Read only
                        </span>

                    </div>

                </div>


                <!-- Buttons -->
                <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

                    <!-- Cancel -->
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="inline-flex items-center justify-center rounded-xl border border-slate-200 px-6 py-3 text-sm font-bold text-slate-600 transition hover:bg-slate-50">
                        Cancel
                    </a>


                    <!-- Save -->
                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-7 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md">

                        <span>✓</span>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>


        <!-- Account Navigation -->
        <div class="mt-6 flex flex-wrap justify-center gap-4 text-sm">

            <a asp-controller="Home"
               asp-action="Index"
               class="font-semibold text-slate-500 transition hover:text-indigo-600">
                🏠 Home
            </a>

            <span class="text-slate-300">|</span>

            <a asp-controller="Account"
               asp-action="Profile"
               class="font-semibold text-indigo-600">
                👤 Profile
            </a>

        </div>

    </div>

</div>


<script>
    <partial name="_ValidationScriptsPartial" />

    <script>

        const imageInput = document.getElementById("profileImageInput");
        const fileName = document.getElementById("fileName");

        imageInput.addEventListener("change", function () {

            const file = this.files[0];

            if (!file) {
                fileName.textContent = "No image selected";
                return;
            }

            fileName.textContent = file.name;

            // Preview selected image
            const reader = new FileReader();

            reader.onload = function (e) {

                let preview = document.getElementById("profilePreview");

                if (!preview) {

                    const placeholder =
                        document.getElementById("profilePlaceholder");

                    if (placeholder) {
                        placeholder.remove();
                    }

                    preview = document.createElement("img");

                    preview.id = "profilePreview";
                    preview.alt = "Profile";
                    preview.className =
                        "h-28 w-28 rounded-full border-4 border-white object-cover shadow-lg";

                    imageInput.closest("div").before(preview);
                }

                preview.src = e.target.result;
            };

            reader.readAsDataURL(file);

        });

    </script>
}

</script>